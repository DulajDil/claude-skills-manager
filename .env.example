# Port for the Express server
PORT=3002

# Directory where skills are stored as SKILL.md files.
# Defaults to ~/.claude-shared/skills
# Point this at ~/.claude/skills if you don't use a shared skills library.
# dotenv does NOT expand $HOME, so use an absolute path.
# SKILLS_DIR=/Users/you/.claude/skills

# Directory holding agents. Defaults to ~/.claude/agents
# AGENTS_DIR=/Users/you/.claude/agents

# Where the starter set lives. Defaults to ./bundled-skills in this repo —
# you normally do not need to set this.
# BUNDLED_SKILLS_DIR=/path/to/bundled-skills

# Optional: SkillsMP API key for higher rate limits (500 req/day vs 50 req/day)
# Get a free key at https://skillsmp.com
# SKILLSMP_API_KEY=sk_live_your_key_here
