{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node server/dist/index.js",
    "healthcheckPath": "/api/skills",
    "restartPolicyType": "ON_FAILURE"
  }
}
